{
  "name": "RoyalEconomy basics: balance, pay, errors, admin, RoyalBank through Vault",
  "instance": "econ-a",
  "bots": ["alice", "bob"],
  "setup": ["op alice", "eco give alice 900"],
  "steps": [
    { "bot": "alice", "command": "/balance" },
    { "bot": "alice", "expectMessage": "/1,000[.]00/" },
    { "bot": "bob", "command": "/balance" },
    { "bot": "bob", "expectMessage": "/100[.]00/" },
    { "bot": "alice", "command": "/pay bob 250" },
    { "bot": "alice", "expectMessage": "/sent .*250[.]00/" },
    { "bot": "bob", "expectMessage": "/received .*250[.]00/" },
    { "bot": "bob", "command": "/balance" },
    { "bot": "bob", "expectMessage": "/350[.]00/" },
    { "bot": "alice", "command": "/pay bob 99999" },
    { "bot": "alice", "expectMessage": "/enough money/" },
    { "bot": "alice", "command": "/pay alice 5" },
    { "bot": "alice", "expectMessage": "/pay yourself/" },
    { "bot": "alice", "command": "/pay bob 0.001" },
    { "bot": "alice", "expectMessage": "/not a valid amount/" },
    { "bot": "alice", "command": "/pay bob -5" },
    { "bot": "alice", "expectMessage": "/not a valid amount/" },
    { "bot": "alice", "command": "/pay bob abc" },
    { "bot": "alice", "expectMessage": "/not a valid amount/" },
    { "bot": "alice", "command": "/pay nobodyhere 5" },
    { "bot": "alice", "expectMessage": "/never joined/" },
    { "bot": "bob", "command": "/eco give bob 1" },
    { "bot": "bob", "expectMessage": "/can't do that|permission/i" },
    { "bot": "alice", "command": "/balance bob" },
    { "bot": "alice", "expectMessage": "/bob has .*350[.]00/" },
    { "bot": "alice", "command": "/bank deposit 200" },
    { "bot": "alice", "expectMessage": "/Deposited/i" },
    { "bot": "alice", "command": "/balance" },
    { "bot": "alice", "expectMessage": "/550[.]00/" },
    { "expectLog": { "absent": "/Exception|SEVERE|ERROR.: .Royal/" } }
  ]
}
